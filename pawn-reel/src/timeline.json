{
  "duration": 45,
  "fps": 30,
  "voice": [
    {"src": [0.00, 0.74], "at": 0.20, "text": "Це пішак.", "hl": ["пішак"]},
    {"src": [1.11, 3.01], "at": 1.00, "text": "Йому казали, що він нічого не вартий.", "hl": ["нічого"]},
    {"src": [3.68, 5.95], "at": 3.25, "text": "За сорок секунд він усіх здивує.", "hl": ["здивує"]},
    {"src": [6.41, 9.99], "at": 5.90, "text": "Поки інші стрибають і літають, він ходить по одній клітинці.", "hl": ["одній"]},
    {"src": [10.27, 10.82], "at": 9.75, "text": "Повільно.", "hl": []},
    {"src": [11.36, 13.62], "at": 10.60, "text": "Але кожен його хід — обдуманий.", "hl": ["обдуманий"]},
    {"src": [14.08, 15.28], "at": 13.10, "text": "І ось на шляху слон.", "hl": ["слон"]},
    {"src": [16.32, 18.31], "at": 14.90, "text": "Найприкріший суперник для пішака.", "hl": []},
    {"src": [18.70, 20.00], "at": 17.20, "text": "Здавалося б, не обійти.", "hl": []},
    {"src": [20.41, 21.77], "at": 19.00, "text": "Але в пішаків є секрет.", "hl": ["секрет"]},
    {"src": [22.36, 24.35], "at": 20.70, "text": "Ходять вони прямо, а б'ють навскіс.", "hl": ["навскіс"]},
    {"src": [24.72, 26.27], "at": 23.40, "text": "Слон такого точно не чекав.", "hl": []},
    {"src": [26.74, 28.09], "at": 26.60, "text": "І ось остання клітинка.", "hl": ["остання"]},
    {"src": [28.84, 30.32], "at": 28.60, "text": "Та сама, заради якої все.", "hl": []},
    {"src": [30.68, 33.19], "at": 35.70, "text": "Ось чому в шахах не буває «просто пішака».", "hl": ["«просто"]},
    {"src": [33.60, 35.62], "at": 38.65, "text": "Кожен із них — майбутній ферзь.", "hl": ["ферзь."]},
    {"src": [36.25, 38.82], "at": 41.10, "text": "Підписуйся, далі буде ще одна історія.", "hl": []}
  ],
